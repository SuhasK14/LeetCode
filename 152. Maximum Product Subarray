class Solution {
    public int maxProduct(int[] nums) {
        // guaranteed one element in nums, use as starting / default max
        int max = nums[0];
        // update two vars: highest and lowest, as lowest min could be flipped negative and become highest
        int curMax = nums[0];
        int curMin = nums[0];
        // loop through nums, evaluating on each element
        for (int i = 1; i < nums.length; i++) {
            // update current max and min vals, and check final max to be returned
            int temp = curMax * nums[i];
            curMax = Math.max(curMin * nums[i], Math.max(temp, nums[i]));
            curMin = Math.min(curMin * nums[i], Math.min(temp, nums[i]));
            max = Math.max(max, curMax);
        }
        return max;
    }
}
